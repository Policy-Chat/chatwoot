# ============================================================================
# Chatwoot production env template — Policy-Chat secure-chat POC (epic COR-402)
# ============================================================================
# This is a TEMPLATE. It contains NO secret values. At runtime the ECS task
# definitions (COR-411) inject every sensitive value from AWS Secrets Manager
# (region us-east-1) — the `secrets` block of each container maps the SM ARN to
# the env var below. Non-secret settings are passed as plain `environment`.
#
# Secrets Manager entries (KMS: alias/chat-cmk):
#   chat-poc/db_password              -> POSTGRES_PASSWORD
#   chat-poc/redis_auth               -> REDIS_PASSWORD
#   chat-poc/secret_key_base          -> SECRET_KEY_BASE
#   chat-poc/vault_service_account_key-> (vault/transit integration)
#   chat-poc/webhook_hmac_secret      -> (inbound webhook signature verification)
#   chat-poc/agent_bot_token          -> (agent bot API access)
#
# NEVER commit real values here. Secrets live only in Secrets Manager.
# ----------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
# Public URL served by CloudFront -> WAF -> ALB (COR-412).
FRONTEND_URL=
# Force TLS at the edge.
FORCE_SSL=true

# --- Secret (sourced from Secrets Manager at runtime; leave blank here) ------
SECRET_KEY_BASE=

# --- Postgres (Aurora via RDS Proxy, COR-410) -------------------------------
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=
# Aurora + Proxy enforce TLS.
POSTGRES_SSLMODE=require

# --- Redis (ElastiCache, COR-410) -------------------------------------------
REDIS_URL=
REDIS_PASSWORD=
REDIS_OPENSSL_VERIFY_MODE=none

# --- Object storage (S3 attachments bucket, COR-410) ------------------------
ACTIVE_STORAGE_SERVICE=amazon
STORAGE_REGION=us-east-1
STORAGE_BUCKET_NAME=
# Access is via the ECS task role (IAM) — no static keys.

# --- Sidekiq ----------------------------------------------------------------
SIDEKIQ_CONCURRENCY=10

# --- Mailer (configure when outbound email is wired; none for POC) ----------
MAILER_SENDER_EMAIL=
SMTP_ADDRESS=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Integrations (POC: redaction sidecar + webhook signing) ----------------
# Webhook HMAC + agent bot token are injected from Secrets Manager at runtime.
ENABLE_ACCOUNT_SIGNUP=false
